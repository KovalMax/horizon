# Production API runtime image. Scan and validate the exact build before deployment.
FROM rust:1.99.1-slim AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends make perl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
RUN mkdir src \
    && printf 'fn main() {}\n' > src/main.rs \
    && printf '\n' > src/lib.rs \
    && cargo build --release --locked
COPY src ./src
COPY migrations ./migrations
RUN touch src/main.rs src/lib.rs migrations/*.sql \
    && cargo build --release --locked

FROM gcr.io/distroless/cc-debian13:nonroot
WORKDIR /app
COPY --from=build /app/target/release/horizon-api /app/horizon-api
EXPOSE 8000
ENTRYPOINT ["/app/horizon-api"]
