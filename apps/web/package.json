{
  "name": "horizon-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:e2e:stack": "playwright test --config playwright.stack.config.ts",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' 'e2e*/**/*.{ts,tsx}' 'playwright*.config.ts' 'vite.e2e.config.ts' 'vitest.config.ts'",
    "format:write": "prettier --write 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' 'e2e*/**/*.{ts,tsx}' 'playwright*.config.ts' 'vite.e2e.config.ts' 'vitest.config.ts'"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
